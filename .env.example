# Copy this file to .env and fill in real values.

# HMAC salt for hashing commenter identifiers before anything touches
# disk. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=

# YouTube Data API v3 key. Required for channel/video/comment collection.
YT_API_KEY=

# TCMB EVDS registration key. Required only for the market extra.
EVDS_API_KEY=
